<Window x:Class="ToDoTree.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ToDoTree.App.Controls"
        xmlns:converters="clr-namespace:ToDoTree.App.Converters"
        xmlns:vm="clr-namespace:ToDoTree.App.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="Assets/AppIcon.ico"
        Height="860" Width="1440" MinHeight="560" MinWidth="900"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="12.5" PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.DataContext>
        <vm:WorkspaceViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:EnumLabelConverter x:Key="EnumLabel" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ツールバーのアイコン（線画） -->
        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.TextSubtle}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ヘッダーの検索欄などに置く、枠を持たない入力欄 -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding ActiveDocument.SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding ActiveDocument.SaveAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding ActiveDocument.UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding ActiveDocument.RedoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="L" Command="{Binding ActiveDocument.AlignCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="I" Command="{Binding ActiveDocument.ImportOutlineCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="E" Command="{Binding ActiveDocument.ExportCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ActiveDocument.StartConnectCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="G" Command="{Binding ActiveDocument.GroupSelectionCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="G" Command="{Binding ActiveDocument.UngroupBlockCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ActiveDocument.ZoomFitCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ActiveDocument.ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ActiveDocument.ZoomOutCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="D" Command="{Binding ActiveDocument.ToggleThemeCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="M" Command="{Binding ActiveDocument.ToggleNodeStyleCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ ヘッダー ============ -->
        <Border Grid.Row="0" DataContext="{Binding ActiveDocument}"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="20,0" Height="68">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- アプリの印 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource Brush.Accent}">
                        <Path Data="M 4.5,12 H 9 M 9,12 V 6.5 H 13.5 M 9,12 V 17.5 H 13.5"
                              Width="15" Height="15" Stretch="Uniform"
                              Stroke="{DynamicResource Brush.TextOnAccent}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ToDoTree" Style="{StaticResource Text.AppMark}" Margin="9,0,0,0" />
                    <Border Style="{StaticResource Rule.Vertical}" Height="20" Margin="14,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- プロジェクト名 -->
                <TextBox Grid.Column="1" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left"
                         Style="{StaticResource BareTextBox}" FontSize="18" FontWeight="SemiBold"
                         Text="{Binding ProjectName, UpdateSourceTrigger=LostFocus}"
                         ToolTip="プロジェクト名" />

                <!-- 検索・タグ・配色 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Width="230" Height="32" CornerRadius="9"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left" Style="{StaticResource ToolIcon}"
                                  Data="{StaticResource Icon.Search}" Width="13" Height="13" Margin="9,0,7,0" />
                            <Button DockPanel.Dock="Right" Command="{Binding ClearSearchCommand}"
                                    Width="24" Height="24" Margin="0,0,4,0" ToolTip="検索をやめる">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Close}"
                                      Width="10" Height="10" StrokeThickness="1.9" />
                            </Button>
                            <Grid>
                                <TextBox x:Name="SearchBox" Style="{StaticResource BareTextBox}" FontSize="12"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnSearchKeyDown"
                                         AutomationProperties.Name="ステップを検索"
                                         ToolTip="タイトル・メモ・タグから探す (Ctrl+F)&#10;↓: 一覧へ / Enter: 選択した結果へ / Esc: 検索を解除" />
                                <TextBlock Text="検索 (Ctrl+F)" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextFaint}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <ComboBox Width="132" Height="32" Margin="8,0,0,0" Tag="タグで絞り込む"
                              ItemsSource="{Binding AvailableTags}"
                              SelectedItem="{Binding SelectedTag}"
                              IsEditable="False"
                              ToolTip="タグで絞り込む" />

                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding ClearTagCommand}"
                            Width="28" Height="28" Margin="2,0,0,0" ToolTip="タグの絞り込みをやめる">
                        <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Close}"
                              Width="10" Height="10" StrokeThickness="1.9" />
                    </Button>

                    <Border Style="{StaticResource Rule.Vertical}" Height="20" Margin="10,0" VerticalAlignment="Center" />

                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding ThemeTooltip}">
                        <Path Width="16" Height="16">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource ToolIcon}">
                                    <Setter Property="Data" Value="{StaticResource Icon.Moon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Icon.Sun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ プロジェクトタブ ============ -->
        <Border Grid.Row="1" MinHeight="40" Padding="10,5,10,0"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Width="28" Height="28" Margin="8,0,0,5"
                        Style="{StaticResource Btn.Icon}" Command="{Binding NewProjectCommand}"
                        Content="＋" FontSize="16" ToolTip="新しいプロジェクトをタブで開く" />

                <TabControl ItemsSource="{Binding Documents}"
                            SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                            Background="Transparent" BorderThickness="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <TabPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder" MinWidth="116" MaxWidth="260" Height="34"
                                                Padding="12,0,5,0" CornerRadius="9,9,0,0"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding FilePathDisplay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TabTitle}" MaxWidth="205"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Width="20" Height="20" Margin="7,0,0,0"
                                        Style="{StaticResource Btn.Icon}" Content="×" FontSize="14"
                                        Command="{Binding DataContext.CloseProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="このプロジェクトを閉じる" />
                            </Grid>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- ============ ツールバー ============ -->
        <Border Grid.Row="2" DataContext="{Binding ActiveDocument}"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="11,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" Content="ファイル ▾" Click="OnToolbarMenuClick"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="プロジェクトの作成・読み込み・保存・書き出し">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="新しいプロジェクト" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                                <MenuItem Header="開く" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                                <Separator />
                                <MenuItem Header="保存" Command="{Binding ActiveDocument.SaveCommand}" InputGestureText="Ctrl+S" />
                                <MenuItem Header="名前を付けて保存" Command="{Binding ActiveDocument.SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                                <Separator />
                                <MenuItem Header="書き出す" Command="{Binding ActiveDocument.ExportCommand}" InputGestureText="Ctrl+Shift+E" />
                                <MenuItem Header="図をコピー（Mermaid）" Command="{Binding ActiveDocument.CopyMermaidCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding SaveCommand}"
                            Content="保存" ToolTip="保存 (Ctrl+S)" />

                    <Border Style="{StaticResource Rule.Vertical}" Height="20" VerticalAlignment="Center" />

                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding AddChildCommand}"
                            Content="＋ 続き" ToolTip="選択中のステップの続きを追加 (Enter)" Margin="2,0,6,0" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="ステップ ▾" Click="OnToolbarMenuClick"
                            ToolTip="ステップの追加・接続・分割・削除">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="独立したステップを追加" Command="{Binding AddRootCommand}" />
                                <MenuItem Header="続きを追加" Command="{Binding AddChildCommand}" InputGestureText="Enter" />
                                <MenuItem Header="並行して追加" Command="{Binding AddSiblingCommand}" InputGestureText="Shift+Enter" />
                                <MenuItem Header="まとめて入力" Command="{Binding ImportOutlineCommand}" InputGestureText="Ctrl+I" />
                                <MenuItem Header="選択範囲を部品として保存…" Command="{Binding SaveTemplateCommand}" />
                                <MenuItem Header="部品ライブラリ…" Command="{Binding OpenTemplatesCommand}" />
                                <Separator />
                                <MenuItem Header="ここから繋ぐ" Command="{Binding StartConnectCommand}" InputGestureText="Ctrl+E" />
                                <MenuItem Header="分割" Command="{Binding SplitCommand}" />
                                <Separator />
                                <MenuItem Header="ブロックにまとめる" Command="{Binding GroupSelectionCommand}" InputGestureText="Ctrl+G" />
                                <MenuItem Header="ブロックから外す" Command="{Binding RemoveFromBlockCommand}" />
                                <MenuItem Header="ブロックを解除" Command="{Binding UngroupBlockCommand}" InputGestureText="Ctrl+Shift+G" />
                                <Separator />
                                <MenuItem Header="削除" Command="{Binding DeleteCommand}" InputGestureText="Delete" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Style="{StaticResource Rule.Vertical}" Height="20" VerticalAlignment="Center" />

                    <!-- ブロックを選んでいるときは、その中だけが対象になる。文言で対象を示す。 -->
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding AlignCommand}"
                            Content="{Binding AlignLabel}" ToolTip="{Binding AlignTooltip}" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="表示 ▾" Click="OnToolbarMenuClick"
                            ToolTip="配置方向・カード表示・最長経路・フォーカス">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{Binding DirectionLabel}" Command="{Binding ToggleDirectionCommand}" ToolTip="流れる向きを切り替える" />
                                <MenuItem Header="{Binding NodeStyleLabel}" Command="{Binding ToggleNodeStyleCommand}"
                                          InputGestureText="Ctrl+Shift+M" ToolTip="{Binding NodeStyleTooltip}" />
                                <Separator />
                                <MenuItem Header="中を整列" Command="{Binding LayoutBlockCommand}"
                                          ToolTip="{Binding BlockLayoutHint}" ToolTipService.ShowOnDisabled="True" />
                                <MenuItem Header="全体を整列" Command="{Binding AutoLayoutCommand}"
                                          ToolTip="ブロックの中は動かさず、未所属のステップを並べ直します" />
                                <Separator />
                                <MenuItem Header="{Binding CriticalPathLabel}" Command="{Binding ToggleCriticalPathCommand}" />
                                <MenuItem Header="{Binding FocusLabel}" Command="{Binding ToggleFocusCommand}" />
                                <MenuItem Header="全部開く" Command="{Binding ExpandAllCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding UndoCommand}" ToolTip="元に戻す (Ctrl+Z)">
                        <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Undo}" />
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding RedoCommand}" ToolTip="やり直す (Ctrl+Y)">
                        <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Redo}" />
                    </Button>

                    <Border Style="{StaticResource Rule.Vertical}" Height="18" VerticalAlignment="Center" />

                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding ZoomOutCommand}" ToolTip="縮小 (Ctrl+-)">
                        <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Minus}" />
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding ZoomInCommand}" ToolTip="拡大 (Ctrl++)">
                        <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Plus}" />
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding ZoomFitCommand}" ToolTip="全体表示 (Ctrl+0)">
                        <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Fit}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 本体 ============ -->
        <Grid Grid.Row="3" DataContext="{Binding ActiveDocument}" Margin="16,16,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="284" MinWidth="190" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="336" MinWidth="270" />
            </Grid.ColumnDefinitions>

            <!-- 左：次にやること＋一覧 -->
            <Grid Grid.Column="0">
                <Border Style="{StaticResource Panel.Shadow}" />
                <Border Style="{StaticResource Panel.Card}" Padding="12,10,8,12">
                    <DockPanel>

                        <Border DockPanel.Dock="Top" Margin="0,2,4,14" Padding="14" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="プロジェクトの進捗" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock Text="{Binding ProgressText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,10" TextWrapping="Wrap" />
                                <ProgressBar Height="7" Minimum="0" Maximum="1" Value="{Binding ProgressRatio, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <!-- 次にやること -->
                        <Expander DockPanel.Dock="Top" Header="受信箱（仮置き）" Foreground="{DynamicResource Brush.Text}" IsExpanded="True" Margin="0,0,4,10">
                            <StackPanel Margin="2,6,2,0">
                                <TextBlock Text="名前だけ残して、あとでグラフへ配置" FontSize="11" Foreground="{DynamicResource Brush.TextSubtle}" />
                                <DockPanel Margin="0,6,0,6">
                                    <Button DockPanel.Dock="Right" Content="追加" Style="{StaticResource Btn.Outline}" Command="{Binding AddInboxCommand}" Margin="4,0,0,0" />
                                    <TextBox Text="{Binding InboxTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnInboxInputKeyDown" AutomationProperties.Name="受信箱に追加するToDo" />
                                </DockPanel>
                                <TextBlock Text="{Binding InboxItems.Count, StringFormat='未整理 {0} 件'}" FontSize="11" Foreground="{DynamicResource Brush.TextSubtle}" />
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding InboxItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right" Content="×" Width="24" Padding="0" Style="{StaticResource Btn.Ghost}" ToolTip="受信箱から削除（Ctrl+Zで戻せます）" Command="{Binding DataContext.ActiveDocument.DeleteInboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <Button DockPanel.Dock="Right" Content="配置" Padding="6,4" Style="{StaticResource Btn.Outline}" Command="{Binding DataContext.ActiveDocument.PlaceInboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,4,6,0" Cursor="Hand" ToolTip="キャンバスへドラッグして配置" MouseLeftButtonDown="OnInboxDragStart" MouseMove="OnInboxDragMove" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>
                        <Border DockPanel.Dock="Top" Margin="0,2,4,0" Padding="12,10"
                                Background="{DynamicResource Brush.SuccessSoft}"
                                BorderBrush="{DynamicResource Brush.SuccessBorder}"
                                BorderThickness="1" CornerRadius="12"
                                Visibility="{Binding HasNextActions, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.Success}" />
                                    <TextBlock Text="次にやること" Margin="7,0,0,0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Success}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding NextActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Btn.Row}" Padding="7,5"
                                                    Command="{Binding DataContext.ActiveDocument.FocusNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Node}"
                                                    ToolTip="クリックでこのステップへ移動">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Text}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding RankLabel, Mode=OneWay}"
                                                             Foreground="{DynamicResource Brush.Success}" />
                                                        <Run Text="{Binding Node.Title, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Reason}" FontSize="10.5" TextWrapping="Wrap"
                                                               Margin="0,1,0,0"
                                                               Foreground="{DynamicResource Brush.TextSubtle}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 一覧の見出し -->
                        <Grid DockPanel.Dock="Top" Margin="0,4,4,2">
                            <TextBlock Text="ステップ一覧" Style="{StaticResource Text.Section}" />
                            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                      Content="完了を隠す" IsChecked="{Binding HideCompleted}"
                                      ToolTip="済んだステップをキャンバスと一覧から外す" />
                        </Grid>

                        <TextBlock DockPanel.Dock="Top" Margin="4,0,4,8"
                                   Text="{Binding SidebarNodes.Count, StringFormat='表示 {0} 件'}"
                                   Foreground="{DynamicResource Brush.TextSubtle}" FontSize="11" />
                        <TextBlock DockPanel.Dock="Top" Margin="4,8,4,12" TextWrapping="Wrap"
                                   Text="表示できるステップがありません。検索語・タグ・「完了を隠す」を確認してください。"
                                   Foreground="{DynamicResource Brush.TextSubtle}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SidebarNodes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="SidebarList" ItemsSource="{Binding SidebarNodes}"
                                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                 MouseDoubleClick="OnSidebarDoubleClick" PreviewKeyDown="OnSidebarKeyDown"
                                 Padding="0,0,4,0"
                                 ToolTip="Enter またはダブルクリックでその位置へ移動します">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="999" Background="{Binding StatusBrush}" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                       FontSize="12.5"
                                                       Foreground="{Binding TitleBrush}"
                                                       TextDecorations="{Binding TitleDecorations}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10" Margin="7,0,0,0"
                                                           Foreground="{DynamicResource Brush.TextFaint}" />
                                                <TextBlock Text="{Binding RepeatText}" FontSize="10" Margin="7,0,0,0"
                                                           Foreground="{Binding RepeatTextBrush}"
                                                           Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" />

            <!-- 中央：グラフ -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource Panel.Shadow}" />
                <Border Style="{StaticResource Panel.Card}" Padding="1" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="18,14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ゴールへの道のり" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="ステップをつないで、次の一歩を明確に。" Margin="0,4,8,0" FontSize="11" Foreground="{DynamicResource Brush.TextSubtle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Outline}" Command="{Binding ZoomFitCommand}" Content="全体表示" VerticalAlignment="Center" ToolTip="全体表示 (Ctrl+0)" />
                            </Grid>
                        </Border>
                        <controls:GraphView x:Name="Graph" />
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" />

            <!-- 右：詳細 -->
            <Grid Grid.Column="4">
                <Border Style="{StaticResource Panel.Shadow}" />
                <Border Style="{StaticResource Panel.Card}" Padding="16,12,10,14">
                    <ScrollViewer Style="{StaticResource Scroll.Viewer}" VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,6,0">
                        <StackPanel>

                            <TextBlock Text="作業のしおり" Style="{StaticResource Text.Section}" Margin="2,0,0,6" />
                            <TextBlock Text="{Binding BookmarkTitle}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextSubtle}" Margin="2,0,0,6" />
                            <Button Content="選択したカードにしおりを置く" Style="{StaticResource Btn.Outline}" Command="{Binding SetBookmarkCommand}"
                                    ToolTip="プロジェクトに1つ保存できます。別のカードに置くと再開メモも置き換わります。" />
                            <StackPanel Visibility="{Binding HasBookmark, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="再開メモ（次にすること・詰まったこと）" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding BookmarkNote, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                         VerticalScrollBarVisibility="Auto" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="しおりへ戻る" Style="{StaticResource Btn.Primary}" Command="{Binding ResumeBookmarkCommand}" Margin="0,0,6,0" />
                                    <Button Content="しおりを外す" Style="{StaticResource Btn.Ghost}" Command="{Binding ClearBookmarkCommand}" />
                                </WrapPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Rule.Horizontal}" Margin="0,14" />

                            <!-- 何も選んでいないとき -->
                            <StackPanel Margin="0,26,0,0"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <Border Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Center"
                                        Background="{DynamicResource Brush.SurfaceAlt}">
                                    <Path Data="M 4.5,12 H 9 M 9,12 V 6.5 H 13.5 M 9,12 V 17.5 H 13.5"
                                          Width="22" Height="22" Stretch="Uniform"
                                          Stroke="{DynamicResource Brush.TextFaint}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="ステップを選ぶと、ここに中身が出ます"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                                           Foreground="{DynamicResource Brush.TextSubtle}" />
                                <TextBlock Text="カードをクリックするか、＋ ステップ で追加してください"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.TextFaint}" />
                            </StackPanel>

                            <!-- 選択中のステップ -->
                            <StackPanel DataContext="{Binding SelectedNode}"
                                        Visibility="{Binding DataContext.ActiveDocument.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">

                                <TextBlock Text="タイトル" Style="{StaticResource Text.Label}" Margin="2,2,0,5" />
                                <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13.5" FontWeight="SemiBold" Padding="10,8"
                                         KeyDown="OnTitleBoxKeyDown"
                                         ToolTip="Enter で続きのステップ、Shift+Enter で並行のステップを追加します" />

                                <Border Style="{StaticResource Panel.Flat}" Padding="10" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Button Content="{Binding BlockToggleLabel}" Command="{Binding ToggleBlockCommand}" Style="{StaticResource Btn.Outline}" />
                                        <StackPanel Visibility="{Binding IsManuallyBlocked, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="ブロックの理由（任意）" Style="{StaticResource Text.Label}" />
                                            <TextBox Text="{Binding BlockReason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                        <TextBlock Text="この作業・ゴールが止まっている理由" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,4" />
                                        <TextBlock Text="{Binding BlockingSummary}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSubtle}" />
                                        <ItemsControl ItemsSource="{Binding BlockingCauses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Btn.Row}" Margin="0,4,0,0" Command="{Binding DataContext.ActiveDocument.FocusBlockingCauseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Node}" ToolTip="原因のカードへ移動">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Node.Title}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Reason}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSubtle}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="状態" Style="{StaticResource Text.Label}" />

                                        <!--
                                            回数つきの項目では汎用のドロップダウンを出さない。
                                            途中の回数のまま「完了」を選べてしまうため。
                                            代わりに下の「繰り返し」の専用操作で動かす。
                                        -->
                                        <ComboBox ItemsSource="{Binding DataContext.ActiveDocument.StatusValues, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Status}"
                                                  Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Border Padding="10,7" CornerRadius="8"
                                                Background="{DynamicResource Brush.SurfaceAlt}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                ToolTip="回数の操作で状態が決まります"
                                                Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding StatusLabel}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="種別" Style="{StaticResource Text.Label}" />
                                        <ComboBox ItemsSource="{Binding DataContext.ActiveDocument.KindValues, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Kind}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="期限" Style="{StaticResource Text.Label}" />
                                        <DatePicker SelectedDate="{Binding DueDate}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="見積り（分）" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding EstimateText, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="タグ（, 区切り）" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Text="メモ" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                         VerticalScrollBarVisibility="Auto" />

                                <!-- ============ 回数で完了する項目 ============ -->
                                <Expander Header="チェックリスト" Foreground="{DynamicResource Brush.Text}" IsExpanded="True" Margin="0,14,0,0">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding ChecklistSummary}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="11" />
                                        <ItemsControl ItemsSource="{Binding ChecklistItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4">
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="{Binding Title}" />
                                                        <Button DockPanel.Dock="Right" Content="×" Width="24" Padding="0" Style="{StaticResource Btn.Ghost}" ToolTip="チェック項目を削除" Command="{Binding DeleteCommand}" />
                                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="チェック項目名" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <DockPanel Margin="0,5,0,0">
                                            <Button DockPanel.Dock="Right" Content="追加" Style="{StaticResource Btn.Outline}" Command="{Binding AddChecklistCommand}" Margin="4,0,0,0" />
                                            <TextBox Text="{Binding NewChecklistTitle, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnChecklistInputKeyDown" AutomationProperties.Name="新しいチェック項目" />
                                        </DockPanel>
                                        <TextBlock Text="全項目をチェックしても、カードの完了は手動で行います。" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Brush.TextSubtle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Expander>
                                <Border Style="{StaticResource Panel.Flat}" Padding="12,10" Margin="0,14,0,0"
                                        Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="繰り返し" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.TextFaint}" />
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                       Text="{Binding RepeatText}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{Binding RepeatTextBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding RepeatActionTooltip}" FontSize="11" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSubtle}" />

                                        <WrapPanel Margin="0,9,0,0">
                                            <Button Content="1回達成" Style="{StaticResource Btn.Primary}"
                                                    Padding="14,6" Margin="0,0,7,7"
                                                    AutomationProperties.Name="{Binding RepeatActionName}"
                                                    Command="{Binding DataContext.ActiveDocument.AdvanceRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="1回戻す" Style="{StaticResource Btn.Outline}"
                                                    Padding="14,6" Margin="0,0,7,7"
                                                    Command="{Binding DataContext.ActiveDocument.StepBackRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="着手する" Style="{StaticResource Btn.Outline}"
                                                    Padding="14,6" Margin="0,0,7,7"
                                                    Command="{Binding DataContext.ActiveDocument.BeginRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="{Binding DataContext.ActiveDocument.RepeatCancelLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource Btn.Outline}" Padding="14,6" Margin="0,0,7,7"
                                                    Command="{Binding DataContext.ActiveDocument.ToggleRepeatCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </WrapPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="回数を訂正…" Style="{StaticResource Btn.Link}" FontSize="11"
                                                    Command="{Binding DataContext.ActiveDocument.AdjustRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="繰り返しを解除" Style="{StaticResource Btn.Link}" FontSize="11" Margin="14,0,0,0"
                                                    Command="{Binding DataContext.ActiveDocument.ClearRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button Content="繰り返しを設定…" Style="{StaticResource Btn.Outline}"
                                        Padding="14,6" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        ToolTip="指定した回数を達成したときに完了する項目にします"
                                        Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                        Command="{Binding DataContext.ActiveDocument.ConfigureRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                <CheckBox Margin="2,14,0,0" Content="この位置を固定する（自動整列で動かさない）"
                                          IsChecked="{Binding IsPinned}" />

                                <Border Style="{StaticResource Rule.Horizontal}" Margin="0,14" />

                                <TextBlock Text="先行（これが終わると着手できる）" Style="{StaticResource Text.Section}" Margin="2,0,0,6" />
                                <TextBlock Text="なし" Foreground="{DynamicResource Brush.TextFaint}" FontSize="11" Margin="2,0,0,0"
                                           Visibility="{Binding HasParents, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <ItemsControl ItemsSource="{Binding Parents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}"
                                                        Width="24" Height="24" ToolTip="この繋がりを外す"
                                                        Command="{Binding DataContext.ActiveDocument.RemoveParentLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Close}"
                                                          Width="9" Height="9" StrokeThickness="1.9" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Row}" Content="{Binding Title}"
                                                        ToolTip="このステップへ移動"
                                                        Command="{Binding DataContext.ActiveDocument.FocusNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="後続（これが終わると進める）" Style="{StaticResource Text.Section}" Margin="2,14,0,6" />
                                <TextBlock Text="なし" Foreground="{DynamicResource Brush.TextFaint}" FontSize="11" Margin="2,0,0,0"
                                           Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <ItemsControl ItemsSource="{Binding Children}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}"
                                                        Width="24" Height="24" ToolTip="この繋がりを外す"
                                                        Command="{Binding DataContext.ActiveDocument.RemoveChildLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Style="{StaticResource ToolIcon}" Data="{StaticResource Icon.Close}"
                                                          Width="9" Height="9" StrokeThickness="1.9" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Row}" Content="{Binding Title}"
                                                        ToolTip="このステップへ移動"
                                                        Command="{Binding DataContext.ActiveDocument.FocusNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ ステータスバー ============ -->
        <Border Grid.Row="4" DataContext="{Binding ActiveDocument}"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressText}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
                <ProgressBar DockPanel.Dock="Left" Width="140" Height="6" Margin="12,0" Minimum="0" Maximum="1"
                             Value="{Binding ProgressRatio, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding ReadyText}" Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding ForecastText}" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding ForecastBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding HiddenSummary}" Margin="16,0,0,0"
                           Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionSummary}" Margin="16,0,0,0"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="16,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
