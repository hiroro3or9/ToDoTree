<Window x:Class="ToDoTree.App.Views.ProjectVariablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ToDoTree.App.Converters"
        Title="プロジェクト変数"
        Height="620" Width="820" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="12.5">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="18" Background="{DynamicResource Brush.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="{Binding ProjectName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="ステップの原文に {名前} と書くと、ここで決めた値で表示します。原文は書き換わりません。"
                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSubtle}" />
            <TextBlock Text="{Binding ScopeDescription}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextFaint}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="300" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- 定義の一覧 -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                    <Button DockPanel.Dock="Right" Content="追加" Style="{StaticResource Btn.Outline}"
                            Command="{Binding AddCommand}" />
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSubtle}" FontSize="11" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0" TextWrapping="Wrap" FontSize="11"
                           Text="まだ変数がありません。「追加」で名前と値を決めてください。"
                           Foreground="{DynamicResource Brush.TextFaint}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox x:Name="RowList" ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="変数名" ToolTip="文字または _ で始まる名前。空白は使えません" />
                                    <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="定義値" ToolTip="1 行の文字列。前後の空白はそのまま残ります" />

                                    <Button Grid.Column="3" Content="{}{名前}をコピー" Style="{StaticResource Btn.Link}"
                                            FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding Reference}"
                                            Command="{Binding DataContext.CopyReferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="4" Content="{Binding DeleteLabel}" Style="{StaticResource Btn.Link}"
                                            FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DeleteCommand}"
                                            CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>

                                <DockPanel Margin="2,3,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.TextFaint}" />
                                    <TextBlock Text="{Binding StateText}" FontSize="10.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Visibility="{Binding HasState, Converter={StaticResource BoolToVisibility}}" />
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" />

            <!-- 使用箇所と未定義 -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding UsageHeader}" Style="{StaticResource Text.Section}"
                           Margin="2,0,0,6" />
                <TextBlock DockPanel.Dock="Top" Margin="2,0,0,6" TextWrapping="Wrap" FontSize="11"
                           Text="この変数を参照しているステップはありません。"
                           Foreground="{DynamicResource Brush.TextFaint}"
                           Visibility="{Binding HasUsages, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10" CornerRadius="10"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Visibility="{Binding HasUndefined, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="未定義の参照" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="定義するまで、原文のまま表示します。" FontSize="10.5" Margin="0,2,0,4"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSubtle}" />
                        <ItemsControl ItemsSource="{Binding Undefined}" MaxHeight="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="定義を追加" Style="{StaticResource Btn.Link}"
                                                FontSize="10.5"
                                                Command="{Binding DataContext.DefineUndefinedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Text}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Usages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel.Flat}" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OccurrenceText}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextFaint}" />
                                        <TextBlock Text="{Binding Before}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Brush.TextSubtle}" />
                                        <TextBlock Text="↓" FontSize="10.5" Margin="0,2"
                                                   Foreground="{DynamicResource Brush.TextFaint}"
                                                   Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding After}" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                                                   Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Warning}" FontSize="10.5" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.Danger}"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="2" Margin="2,10,2,0" TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}" Foreground="{DynamicResource Brush.Danger}"
                   Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キャンセル" Style="{StaticResource Btn.Outline}" Padding="18,7" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource Btn.Primary}" Padding="24,7" Margin="9,0,0,0"
                    IsDefault="True" IsEnabled="{Binding CanSave}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
