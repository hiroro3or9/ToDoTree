<Window x:Class="ToDoTree.App.Views.TemplateLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="部品ライブラリ" Width="740" Height="580" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" TextElement.Foreground="{DynamicResource Brush.Text}"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="12.5" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="いつもの流れを、ひとつの部品に" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="一覧からキャンバスへドラッグ、または「配置する」で再利用できます。"
                       Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSubtle}" />
        </StackPanel>
        <Border x:Name="SavePanel" Grid.Row="1" Style="{StaticResource Panel.Flat}" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="DraftSummary" Margin="0,0,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="部品として保存" Style="{StaticResource Btn.Outline}"
                            Margin="10,0,0,0" Click="OnSave" />
                    <TextBox x:Name="NameBox" MaxLength="100" ToolTip="部品の名前" />
                </DockPanel>
                <TextBlock Text="状態・期限・位置固定をリセットし、選択範囲内のつながりを保存します。"
                           Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSubtle}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="6*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="TemplateList" SelectionChanged="OnSelectionChanged"
                     PreviewMouseLeftButtonDown="OnDragStart" PreviewMouseMove="OnDragMove"
                     Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.OverlayBorder}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,5,0,0"
                                       Foreground="{DynamicResource Brush.TextSubtle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Style="{StaticResource Panel.Flat}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="部品の中身" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock x:Name="Details" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource Brush.TextSubtle}" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="閉じる" Style="{StaticResource Btn.Outline}" Click="OnClose" Margin="0,0,10,0" />
            <Button x:Name="InsertButton" Content="配置する" Style="{StaticResource Btn.Outline}"
                    Click="OnInsert" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
