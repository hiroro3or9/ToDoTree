<UserControl x:Class="ToDoTree.App.Views.ProcedureView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:ToDoTree.App.Controls"
 Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
 </UserControl.Resources>
 <Grid Margin="16,10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <WrapPanel>
    <Button Content="{Binding StartLabel}" Command="{Binding StartCommand}" Style="{StaticResource Btn.Primary}" Margin="0,0,8,6"/>
    <Button Content="今回の実施へ" Command="{Binding LatestCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,6"/>
    <Button Content="再開する" Command="{Binding ResumeCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,6"/>
    <Button Content="操作を取り消す" Command="{Binding UndoCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,6"/>
    <Button Content="やり直す" Command="{Binding RedoCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,6"/>
    <Button Content="表示中の実施を書き出す…" Command="{Binding Preview.ExportCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,6" IsEnabled="{Binding HasRun}"/>
   </WrapPanel>
   <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,4"/>
   <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,10">
   <TextBlock Text="実施履歴" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Label" Width="340" Margin="0,0,12,0" AutomationProperties.Name="表示する実施記録"/>
   <TextBlock Text="保存時点" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox ItemsSource="{Binding Checkpoints}" SelectedItem="{Binding SelectedCheckpoint}" DisplayMemberPath="Label" Width="290" AutomationProperties.Name="中断時点の記録"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="作業ステップ">
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel Margin="8,7">
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSubtle}"/>
       <TextBlock Text="{Binding Dependency}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.TextSubtle}"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Expander Grid.Row="1" Header="手順の全体図" Margin="0,8,0,0" Expanded="OnPreviewExpanded">
     <Grid Height="230">
      <controls:GraphView x:Name="PreviewGraph" DataContext="{Binding Preview}" IsHitTestVisible="False" Focusable="False" IsEnabled="False"/>
     </Grid>
    </Expander>
   </Grid>
   <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="{Binding ReadOnlyLabel}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSubtle}"/>
      <TextBlock Text="{Binding SelectedStep.Title}" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,6" TextWrapping="Wrap"/>
      <TextBlock Text="手順説明" FontWeight="SemiBold" Margin="0,8,0,4"/>
      <TextBox Text="{Binding SelectedStep.Instructions, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65"/>
      <TextBlock Text="{Binding SelectedStep.Completed, StringFormat=ステップ完了日時: {0}}" Foreground="{DynamicResource Brush.TextSubtle}" Margin="0,6"/>
      <WrapPanel Margin="0,6" IsEnabled="{Binding CanEdit}">
       <Button Content="{Binding AdvanceLabel}" Command="{Binding AdvanceCommand}" Style="{StaticResource Btn.Primary}" Margin="0,0,6,6"/>
       <Button Content="着手・再開" Command="{Binding StartStepCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,6"/>
       <Button Content="未着手に戻す" Command="{Binding ResetStepCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,6"/>
       <Button Content="取り消す" Command="{Binding CancelStepCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,6"/>
      </WrapPanel>
      <ItemsControl ItemsSource="{Binding Checks}" IsEnabled="{Binding CanEdit}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" Content="{Binding Text}" Margin="0,4"
          Command="{Binding DataContext.ToggleCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel>
       <TextBlock Text="今回の実施メモ" FontWeight="SemiBold" Margin="0,14,0,4"/>
       <TextBox Text="{Binding DraftNote, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" AutomationProperties.Name="今回の実施メモ"/>
       <CheckBox Content="作業が進められない" IsChecked="{Binding DraftBlocked}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,4"/>
       <TextBox Text="{Binding DraftReason, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" ToolTip="進められない理由" AutomationProperties.Name="進められない理由"/>
       <WrapPanel Margin="0,8">
        <TextBlock Text="今回の期限" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <DatePicker SelectedDate="{Binding DraftDue}" IsEnabled="{Binding CanEdit}" Width="155" AutomationProperties.Name="今回の期限"/>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding HasRepeat, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="達成回数" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <TextBox Text="{Binding DraftCount, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" Width="64" AutomationProperties.Name="達成回数"/>
        </StackPanel>
       </WrapPanel>
       <Button Content="メモ・理由・期限・回数を保存" Command="{Binding ApplyDetailsCommand}" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"/>
      </StackPanel>
      <TextBlock Text="{Binding BookmarkLabel}" TextWrapping="Wrap" Margin="0,14,0,6"/>
      <TextBlock Text="再開するステップは左の選択項目です。メモ等は5秒周期・ステップ切替・中断時にも保存します。" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSubtle}"/>
      <TextBox Text="{Binding PauseNote, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPauseNoteReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" Margin="0,6" AutomationProperties.Name="中断メモまたは打切理由"/>
      <WrapPanel>
       <Button Content="中断する" Command="{Binding PauseCommand}" Style="{StaticResource Btn.Primary}" Margin="0,0,8,6"/>
       <Button Content="今回を打ち切る" Command="{Binding AbandonCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,6"/>
       <Button Content="選択項目の完了を訂正して再開" Command="{Binding CorrectCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,6"/>
      </WrapPanel>
      <Expander Header="実施の履歴" Margin="0,12,0,0">
       <TextBox Text="{Binding EventLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto"/>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
