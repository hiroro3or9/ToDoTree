<Window x:Class="ToDoTree.App.Views.CaptureSpecimenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="標本帳に残す" Width="570" Height="460" MinWidth="460" MinHeight="390"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="この達成を標本帳に" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="GoalTitle" Margin="0,8,0,18" TextWrapping="Wrap"/>
            <TextBlock Text="分類" Margin="0,0,0,5"/>
            <ComboBox x:Name="Category" SelectedIndex="0" Margin="0,0,0,16">
                <ComboBoxItem Content="作ったもの"/><ComboBoxItem Content="学んだこと"/><ComboBoxItem Content="達成したこと"/>
            </ComboBox>
            <TextBlock Text="振り返り・得られたこと" Margin="0,0,0,5"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"/>
            <TextBlock Text="ゴールまでのグラフと判断理由を、この時点の記録として保存します。" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Style="{StaticResource Btn.Outline}" IsCancel="True" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="SaveButton" Content="標本帳に保存" Style="{StaticResource Btn.Outline}" Click="Save_Click" MinWidth="112"/>
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="Reflection" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
