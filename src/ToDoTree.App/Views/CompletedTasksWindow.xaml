<Window x:Class="ToDoTree.App.Views.CompletedTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ToDoTree.App.Converters"
        Title="今日完了したタスク — 全プロジェクト"
        Width="840" Height="600" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Border Padding="20" Background="{DynamicResource Brush.Window}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="更新" Style="{StaticResource Btn.Outline}" Command="{Binding RefreshCommand}" />
                <TextBlock Text="今日完了したタスク" FontSize="22" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="閉じたプロジェクトも含めて、今日の作業を振り返れます。" Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextSubtle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Accent}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSubtle}"
                   Text="開いた・保存したプロジェクトが対象です。閉じたプロジェクトは保存済みの内容を表示します。" />
        <Expander DockPanel.Dock="Bottom" Header="読み込めなかったプロジェクトがあります" Margin="0,12,0,0"
                  Foreground="{DynamicResource Brush.Danger}"
                  Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Errors}" TextWrapping="Wrap" FontSize="11" />
            </ScrollViewer>
        </Expander>
        <Grid>
            <ListBox x:Name="CompletedTasksList" ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,8" ToolTip="{Binding FilePathDisplay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CompletedTimeText}" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextSubtle}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Notes}" TextTrimming="CharacterEllipsis" MaxHeight="36"
                                           Foreground="{DynamicResource Brush.TextSubtle}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextSubtle}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="今日はまだ完了したタスクがありません。" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSubtle}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
    </Border>
</Window>
