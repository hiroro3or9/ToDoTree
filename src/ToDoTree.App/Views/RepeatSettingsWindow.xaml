<Window x:Class="ToDoTree.App.Views.RepeatSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="繰り返しを設定"
        SizeToContent="Height" Width="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="12.5">

    <StackPanel Margin="18">

        <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
        <TextBlock x:Name="HintText" FontSize="11" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSubtle}" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="目標回数" Style="{StaticResource Text.Label}" />
                <TextBox x:Name="TargetBox" MaxLength="4" TextChanged="OnCountChanged"
                         AutomationProperties.Name="目標回数" />
                <TextBlock x:Name="TargetRangeText" FontSize="10.5" Margin="2,4,0,0"
                           Foreground="{DynamicResource Brush.TextFaint}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="達成回数" Style="{StaticResource Text.Label}" />
                <TextBox x:Name="CompletedBox" MaxLength="4" TextChanged="OnCountChanged"
                         AutomationProperties.Name="達成回数" />
                <Button Content="0 に戻す" Style="{StaticResource Btn.Link}" FontSize="10.5"
                        HorizontalAlignment="Left" Margin="2,4,0,0" Click="OnResetClick" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Panel.Flat}" Padding="12,10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="BeforeText" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSubtle}" TextWrapping="Wrap" />
                <TextBlock x:Name="AfterText" FontSize="12.5" FontWeight="SemiBold" Margin="0,5,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                <TextBlock x:Name="NoteText" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSubtle}" />
            </StackPanel>
        </Border>

        <!-- 解除は結果を先に見せてから押させる。押した内容は Ctrl+Z で戻せる。 -->
        <StackPanel x:Name="ClearPanel" Margin="0,14,0,0">
            <Border Style="{StaticResource Rule.Horizontal}" Margin="0,0,0,12" />
            <TextBlock x:Name="ClearText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSubtle}" />
            <Button Content="繰り返しを解除" Style="{StaticResource Btn.Outline}" Padding="14,6"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnClearClick" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" Style="{StaticResource Btn.Outline}" Padding="18,7" IsCancel="True" />
            <Button x:Name="ApplyButton" Content="適用" Style="{StaticResource Btn.Primary}" Padding="24,7"
                    Margin="9,0,0,0" IsDefault="True" Click="OnApplyClick" />
        </StackPanel>
    </StackPanel>
</Window>
