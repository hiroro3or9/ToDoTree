<Window x:Class="ToDoTree.App.Views.ProcedureStartWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="実施を開始" Width="500" Height="510" MinHeight="360" MinWidth="400"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Window}"
 Foreground="{DynamicResource Brush.Text}" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="今回の実施を始める" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="前回の記録を残し、すべて未実施で開始します。" Margin="0,8,0,18" TextWrapping="Wrap"/>
   <TextBlock Text="実施名（任意）"/>
   <TextBox x:Name="NameBox" Margin="0,5,0,12" AutomationProperties.Name="実施名"/>
   <TextBlock Text="今回の期限（全ステップ共通・任意）"/>
   <DatePicker x:Name="DuePicker" Margin="0,5,0,12" Width="180" HorizontalAlignment="Left"/>
   <TextBlock Text="今回の変数値" FontWeight="SemiBold" Margin="0,4"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemTemplate><DataTemplate>
    <StackPanel Margin="0,6"><TextBlock Text="{Binding Name}"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/></StackPanel>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="キャンセル" IsCancel="True" Style="{StaticResource Btn.Ghost}" Margin="0,0,10,0"/>
   <Button Content="実施を開始" Click="OnStart" IsDefault="True" Style="{StaticResource Btn.Primary}"/>
  </StackPanel>
 </Grid>
</Window>
