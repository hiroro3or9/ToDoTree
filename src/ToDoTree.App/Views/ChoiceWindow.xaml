<Window x:Class="ToDoTree.App.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="進める道を選ぶ" Width="650" Height="590" MinWidth="500" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="進める道を選ぶ" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SourceTitle}" Margin="0,8,0,16" TextWrapping="Wrap"/>
            <CheckBox x:Name="EnabledChoice" Content="どちらか一方だけ進める分岐にする" IsChecked="True" Margin="0,0,0,12"/>
            <TextBlock Text="一覧から一つ選択します。見送る道には判断理由を残せます。" TextWrapping="Wrap"/>
            <Button Content="まだ決めない（選択を解除）" Style="{StaticResource Btn.Link}" Click="Clear_Click" HorizontalAlignment="Left" Margin="0,10,0,12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="キャンセル" Style="{StaticResource Btn.Outline}" IsCancel="True" MinWidth="96" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource Btn.Outline}" Click="Save_Click" MinWidth="96"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="OptionsList" ItemsSource="{Binding Options}" SelectedValuePath="Id"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="判断理由" Margin="0,8,0,4" Foreground="{DynamicResource Brush.TextSubtle}"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="56" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
