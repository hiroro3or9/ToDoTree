<Window x:Class="ToDoTree.App.Views.OutlineInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="まとめて入力"
        Height="600" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="12.5">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock x:Name="HeaderText" Text="やることを箇条書きで貼り付けてください"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" />
            <TextBlock x:Name="HintText" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,5,0,0"
                       Text="インデント（スペース 2 個 / タブ）で親子になります。選択中のステップの続きとして取り込みます。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Padding="2">
            <TextBox x:Name="InputBox"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas, Yu Gothic UI"
                     FontSize="12.5"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="10" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel.Flat}" Padding="12,10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="書き方" FontSize="10.5" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextFaint}" />
                <TextBlock FontFamily="Cascadia Mono, Consolas, Yu Gothic UI" FontSize="11.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource Brush.Text}"
                           xml:space="preserve">要件をまとめる
  画面のラフを描く
  データ構造を決める @9/10 ~2h #設計
実装する
  画面を作る ~8h</TextBlock>
                <TextBlock FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSubtle}"
                           TextWrapping="Wrap"
                           Text="@9/10 で期限、~2h や ~90m で見積り、#タグ でタグが付きます。行頭の - や ・ は無視されます。" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="Ctrl+Enter で取り込み" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource Brush.TextFaint}" Margin="0,0,14,0" />
            <Button Content="キャンセル" Style="{StaticResource Btn.Outline}" Padding="18,7" IsCancel="True" />
            <Button x:Name="ImportButton" Content="取り込む" Style="{StaticResource Btn.Primary}" Padding="20,7"
                    Margin="9,0,0,0" IsDefault="False" Click="OnImportClick" />
        </StackPanel>
    </Grid>
</Window>
