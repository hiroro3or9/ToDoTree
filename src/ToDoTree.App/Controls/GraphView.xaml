<UserControl x:Class="ToDoTree.App.Controls.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ToDoTree.App.Controls"
             xmlns:converters="clr-namespace:ToDoTree.App.Converters"
             xmlns:behaviors="clr-namespace:ToDoTree.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />


        <!-- 小さな線のシェブロン。操作領域はアイコンより広く確保する。 -->
        <Style x:Key="BlockCollapseButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{Binding HeaderText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding CollapseActionText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding CollapseActionText}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="7"
                                BorderBrush="Transparent" BorderThickness="1">
                            <Grid Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Data="M 4,2 L 8,6 L 4,10" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            色見本の 1 行。ブロックの「色」と線の「色」で共通に使う。
            このメニューの見た目には印を出す場所が無いので、選択中の色は行末のチェックで示す。
        -->
        <Style x:Key="ColorChoiceStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding ApplyCommand}" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="13" Height="13" CornerRadius="3" Margin="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding Swatch}"
                                    BorderBrush="{Binding SwatchStroke}" BorderThickness="1" />
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            <TextBlock Text="✓" Margin="9,0,0,0" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            右クリックのメニュー。押した場所（線・ステップ・背景）で
            GraphView.xaml.cs が出し分ける。DataContext は Viewport から受け継ぐ。
        -->
        <ContextMenu x:Key="EdgeMenu">
            <MenuItem Header="内部ステップを表示" Command="{Binding RevealEdgeCommand}" />
            <!-- 線は細いので、掴んだのがどれかを名前で確かめられるようにする -->
            <MenuItem Header="{Binding EdgeMenuHeader}" IsEnabled="False" FontSize="11" Padding="10,4" />
            <Separator />
            <MenuItem Header="ここに通過点を追加" Command="{Binding AddWaypointCommand}" />
            <MenuItem Header="通過点をすべて解除" Command="{Binding ClearWaypointsCommand}" />
            <MenuItem Header="接続元の接続点" ItemsSource="{Binding FromPortChoices}"
                      IsEnabled="{Binding HasItems, RelativeSource={RelativeSource Self}}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Title}" />
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="接続先の接続点" ItemsSource="{Binding ToPortChoices}"
                      IsEnabled="{Binding HasItems, RelativeSource={RelativeSource Self}}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Title}" />
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="色" ItemsSource="{Binding EdgeColorChoices}"
                      ItemContainerStyle="{StaticResource ColorChoiceStyle}"
                      IsEnabled="{Binding CanColorSelectedEdge}"
                      ToolTip="{Binding EdgeColorHint}" ToolTipService.ShowOnDisabled="True" />
            <Separator />
            <MenuItem Header="ここにステップを挟む" Command="{Binding InsertOnEdgeCommand}" />
            <MenuItem Header="この線を外す" InputGestureText="Delete" Command="{Binding DeleteEdgeCommand}" />
        </ContextMenu>

        <ContextMenu x:Key="WaypointMenu">
            <MenuItem Header="滑らかにする" IsCheckable="True"
                      IsChecked="{Binding IsSelectedWaypointSmooth, Mode=OneWay}" Command="{Binding ToggleWaypointSmoothCommand}" />
            <Separator />
            <MenuItem Header="この通過点を削除" InputGestureText="Delete" Command="{Binding RemoveWaypointCommand}" />
            <MenuItem Header="通過点をすべて解除" Command="{Binding ClearWaypointsCommand}" />
        </ContextMenu>

        <!-- ブロックの見出しを右クリックしたとき。囲みの解除は、ここか Ctrl+Shift+G だけ。 -->
        <ContextMenu x:Key="BlockMenu">
            <MenuItem Header="ここに接続点を追加" Command="{Binding AddBlockPortCommand}" />
            <MenuItem Header="ブロックを畳む / 開く" Command="{Binding CollapseBlockCommand}" />
            <MenuItem Header="このブロックに集中 / 解除" Command="{Binding FocusBlockCommand}" />
            <MenuItem Header="ここから繋ぐ" Command="{Binding StartConnectCommand}" />
            <MenuItem Header="{Binding BlockMenuHeader}" IsEnabled="False" FontSize="11" Padding="10,4" />
            <Separator />
            <MenuItem Header="中を整列" InputGestureText="Ctrl+L" Command="{Binding LayoutBlockCommand}"
                      ToolTip="{Binding BlockLayoutHint}" ToolTipService.ShowOnDisabled="True" />
            <MenuItem Header="名前を変更" InputGestureText="F2" Command="{Binding RenameBlockCommand}" />
            <MenuItem Header="ブロックに入れる" ItemsSource="{Binding BlockMoveTargets}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding HierarchyPath}" />
                        <Setter Property="InputGestureText" Value="{Binding CountText}" />
                        <Setter Property="Command" Value="{Binding MoveSelectedBlockHereCommand}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="親ブロックから外す" Command="{Binding DetachBlockCommand}" />
            <MenuItem Header="このブロックを包む" Command="{Binding WrapBlockCommand}" />
            <MenuItem Header="色" ItemsSource="{Binding BlockColorChoices}"
                      ItemContainerStyle="{StaticResource ColorChoiceStyle}" />
            <MenuItem Header="中のステップを選択" Command="{Binding SelectBlockNodesCommand}" />
            <MenuItem Header="部品として保存…" Command="{Binding SaveTemplateCommand}" />
            <Separator />
            <MenuItem Header="ブロックを解除" InputGestureText="Ctrl+Shift+G" Command="{Binding UngroupBlockCommand}" />
        </ContextMenu>

        <ContextMenu x:Key="BlockPortMenu">
            <MenuItem Header="ドラッグで接続・Alt＋ドラッグで移動" IsEnabled="False" />
            <MenuItem Header="この接続点を削除" InputGestureText="Delete" Command="{Binding RemoveBlockPortCommand}" />
        </ContextMenu>

        <ContextMenu x:Key="NodeMenu">
            <MenuItem Header="続きを追加" InputGestureText="Enter" Command="{Binding AddChildCommand}" />
            <MenuItem Header="並行して追加" InputGestureText="Shift+Enter" Command="{Binding AddSiblingCommand}" />
            <MenuItem Header="ここから繋ぐ" InputGestureText="Ctrl+E" Command="{Binding StartConnectCommand}" />
            <Separator />
            <!--
                回数つきの項目では、この行が「1回達成」になる。混在選択では何が起きるかを見出しに出す。
                実際の振り分けは MainViewModel.ToggleDone が行う。
            -->
            <MenuItem Header="{Binding ToggleDoneLabel}" InputGestureText="Space" Command="{Binding ToggleDoneCommand}"
                      ToolTip="{Binding ToggleDoneHint}" />
            <MenuItem Header="1回戻す" Command="{Binding StepBackRepeatCommand}"
                      Visibility="{Binding IsSelectedRepeating, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{Binding RepeatConfigureLabel}" Command="{Binding ConfigureRepeatCommand}"
                      ToolTip="目標回数と達成回数をまとめて直します" />
            <MenuItem Header="繰り返しを解除" Command="{Binding ClearRepeatCommand}"
                      Visibility="{Binding IsSelectedRepeating, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="この先を畳む / 開く" Command="{Binding CollapseSelectedCommand}" />
            <MenuItem Header="{Binding FocusLabel}" Command="{Binding ToggleFocusCommand}" />
            <MenuItem Header="分割" Command="{Binding SplitCommand}" />
            <MenuItem Header="この枝を選択" Command="{Binding SelectBranchCommand}" />
            <MenuItem Header="選択範囲を部品として保存…" Command="{Binding SaveTemplateCommand}" />
            <Separator />
            <MenuItem Header="ブロックにまとめる" InputGestureText="Ctrl+G" Command="{Binding GroupSelectionCommand}"
                      ToolTip="{Binding GroupHint}" ToolTipService.ShowOnDisabled="True" />
            <!--
                既存のブロックへ入れる。行ごとの DataContext が BlockViewModel なので、
                親をたどらずにそのままコマンドへ繋げられる（サブメニューは別のポップアップに載るため）。
            -->
            <MenuItem Header="ブロックに追加" ItemsSource="{Binding Blocks}"
                      IsEnabled="{Binding CanAddSelectionToBlock}"
                      ToolTip="{Binding AddToBlockHint}" ToolTipService.ShowOnDisabled="True">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Title}" />
                        <Setter Property="InputGestureText" Value="{Binding CountText}" />
                        <Setter Property="Command" Value="{Binding AddSelectionCommand}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="ブロックから外す" Command="{Binding RemoveFromBlockCommand}" />
            <Separator />
            <MenuItem Header="削除" InputGestureText="Delete" Command="{Binding DeleteCommand}" />
        </ContextMenu>

        <ContextMenu x:Key="CanvasMenu">
            <MenuItem Header="ここにステップを追加" Command="{Binding AddNodeHereCommand}" />
            <MenuItem Header="部品ライブラリ…" Command="{Binding OpenTemplatesCommand}" />
            <MenuItem Header="まとめて入力" InputGestureText="Ctrl+I" Command="{Binding ImportOutlineCommand}" />
            <Separator />
            <MenuItem Header="全体を整列" InputGestureText="Ctrl+L" Command="{Binding AutoLayoutCommand}"
                      ToolTip="ブロックの中は動かさず、未所属のステップを並べ直します" />
            <MenuItem Header="全体表示" InputGestureText="Ctrl+0" Command="{Binding ZoomFitCommand}" />
            <MenuItem Header="全部開く" Command="{Binding ExpandAllCommand}" />
        </ContextMenu>

        <!--
            ステップのカード。状態・種別・期限・見積り・タグまで載せる、標準の見た目。
            大きさは NodeViewModel.CardWidth / CardHeight と揃えること（線の接続位置がずれる）。
        -->
        <!-- 自己ループはノードの外側へ描く。線上の回数から設定を開く。 -->
        <DataTemplate x:Key="NodeRepeatLoopTemplate">
            <Grid Width="{Binding RepeatLoopWidth}" Height="{Binding RepeatLoopHeight}">
                <Path Data="{Binding RepeatLoopPath}" Stroke="{Binding RepeatLoopBrush}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      IsHitTestVisible="False" />
                <Path Data="{Binding RepeatLoopArrow}" Stroke="{Binding RepeatLoopBrush}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      IsHitTestVisible="False" />
                <Button Tag="repeat-badge" Style="{StaticResource Btn.Ghost}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Height="24" MinWidth="62"
                        Margin="0" Padding="8,2" FontSize="10.5" FontWeight="Medium"
                        Background="{Binding RepeatBadgeFill}" Foreground="{Binding RepeatTextBrush}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Content="{Binding RepeatText}" Click="OnRepeatBadgeClick"
                        PreviewKeyDown="OnRepeatButtonPreviewKeyDown"
                        AutomationProperties.Name="繰り返しの設定"
                        AutomationProperties.HelpText="{Binding RepeatActionName}"
                        ToolTip="回数を変更・訂正" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NodeCardTemplate">
            <Grid x:Name="Root" Width="242" Height="88" Opacity="{Binding CardOpacity}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NodeRepeatLoopTemplate}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="{Binding RepeatLoopWidth}" Height="{Binding RepeatLoopHeight}"
                                Margin="{Binding RepeatLoopMargin}" Focusable="False"
                                Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" />

                <!-- 選択の輪郭はカードの外側に置き、接続位置とカード寸法を保つ。 -->
                <Border Width="232" Height="96" Margin="-4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="17" BorderThickness="2" BorderBrush="{DynamicResource Brush.Accent}"
                        Opacity="0.45" IsHitTestVisible="False"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                <!-- ブロックを選んでいるあいだ、その中のカードだけに出る控えめな破線 -->
                <Rectangle Width="232" Height="96" Margin="-4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                           RadiusX="17" RadiusY="17" StrokeThickness="1.6" StrokeDashArray="3 3"
                           Stroke="{DynamicResource Block.Member.Stroke}" IsHitTestVisible="False"
                           Visibility="{Binding IsInSelectedBlock, Converter={StaticResource BoolToVisibility}}" />
                <!-- 影だけを受け持つ板。文字がぼやけないよう、中身とは分けてある。 -->
                <Border x:Name="Shadow" Width="224" Height="88" HorizontalAlignment="Left"
                        CornerRadius="13" Background="{Binding Fill}"
                        Effect="{DynamicResource Effect.Card}"
                        IsHitTestVisible="False" />

                <Border x:Name="Card" Width="224" Height="88" HorizontalAlignment="Left"
                        CornerRadius="13"
                        Background="{Binding Fill}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="{Binding CardBorderThickness}"
                        Cursor="SizeAll"
                        ToolTip="{Binding CardTooltip}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 種別を表す色帯 -->
                        <Border Grid.Column="0" CornerRadius="11,0,0,11" Background="{Binding KindAccent}" />

                        <Grid Grid.Column="1" Margin="11,8,10,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 状態 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding StatusBrush}" />
                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding StatusBrush}" />
                                <TextBlock Text="{Binding KindLabel}" FontSize="10" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Node.TextSubtle}" />
                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="999"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.DangerSoft}"
                                        Visibility="{Binding HasAlert, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding AlertText}" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{Binding AlertBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- 名前 -->
                            <Grid Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{Binding TitleBrush}"
                                           TextDecorations="{Binding TitleDecorations}"
                                           TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                                           LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                <!-- カードの上でそのまま名前を書き換える -->
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13.5" FontWeight="SemiBold"
                                         Padding="5,3" VerticalAlignment="Top"
                                         TextWrapping="Wrap" MaxHeight="40" AcceptsReturn="False"
                                         behaviors:FocusBehavior.FocusWhenVisible="True"
                                         KeyDown="OnCardEditorKeyDown"
                                         LostKeyboardFocus="OnCardEditorLostFocus"
                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <!-- 期限・見積り・タグ ／ 回数 ／ 折りたたみ -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding MetaText}" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Node.TextSubtle}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisibility}}" />

                                <!-- 1 回達成。上限まで来たらチェックに変わり、押しても減らない。 -->
                                <Button Grid.Column="2" Tag="repeat-advance"
                                        Style="{StaticResource Btn.Ghost}"
                                        Background="{Binding RepeatBadgeFill}" Foreground="{Binding RepeatTextBrush}"
                                        Content="{Binding RepeatActionGlyph}"
                                        Margin="5,0,0,0" Padding="7,1" MinWidth="26" FontSize="10"
                                        VerticalAlignment="Center"
                                        Click="OnRepeatAdvanceClick"
                                        PreviewKeyDown="OnRepeatButtonPreviewKeyDown"
                                        IsEnabled="{Binding CanAdvanceRepeat}"
                                        AutomationProperties.Name="{Binding RepeatActionName}"
                                        ToolTip="{Binding RepeatActionTooltip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" />

                                <Button Grid.Column="3" Tag="collapse"
                                        Style="{StaticResource Btn.Chip}"
                                        Content="{Binding CollapseLabel}"
                                        Margin="5,0,0,0" VerticalAlignment="Center"
                                        Padding="6,0" MinWidth="22" FontSize="9.5"
                                        Visibility="{Binding CanCollapse, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="この先を畳む / 開く" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ここからドラッグして次のステップへ繋ぐ -->
                <TextBlock Text="⚑" FontSize="17" FontWeight="Bold" Margin="0,-17,24,0"
                           HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.Accent}"
                           Visibility="{Binding HasBookmark, Converter={StaticResource BoolToVisibility}}" />
                <Ellipse x:Name="Connector" Tag="connector" Width="18" Height="18"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Fill="{DynamicResource Node.Connector.Fill}"
                         Stroke="{Binding BorderBrush}" StrokeThickness="2.2"
                         Opacity="0.5" Cursor="Cross"
                         ToolTip="ここからドラッグして、次のステップに繋げます" />
                <Ellipse x:Name="TopConnector" Tag="connector-top" Width="18" Height="18"
                         HorizontalAlignment="Center" VerticalAlignment="Top"
                         Fill="{DynamicResource Node.Connector.Fill}"
                         Stroke="{Binding BorderBrush}" StrokeThickness="2.2"
                         Opacity="0" Cursor="Cross"
                         ToolTip="上からドラッグして、次のステップに繋げます" />
                <Ellipse x:Name="BottomConnector" Tag="connector-bottom" Width="18" Height="18"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Fill="{DynamicResource Node.Connector.Fill}"
                         Stroke="{Binding BorderBrush}" StrokeThickness="2.2"
                         Opacity="0" Cursor="Cross"
                         ToolTip="下からドラッグして、次のステップに繋げます" />
                <Ellipse x:Name="LeftConnector" Tag="connector-left" Width="18" Height="18"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{DynamicResource Node.Connector.Fill}"
                         Stroke="{Binding BorderBrush}" StrokeThickness="2.2"
                         Opacity="0" Cursor="Cross"
                         ToolTip="左からドラッグして、次のステップに繋げます" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnectionDragging, RelativeSource={RelativeSource AncestorType={x:Type controls:GraphView}}}" Value="True">
                    <Setter TargetName="Connector" Property="Opacity" Value="1" />
                    <Setter TargetName="TopConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="BottomConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="LeftConnector" Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Connector" Property="Opacity" Value="1" />
                    <Setter TargetName="TopConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="BottomConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="LeftConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="Shadow" Property="Effect" Value="{DynamicResource Effect.Raised}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Connector" Property="Opacity" Value="1" />
                    <Setter TargetName="TopConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="BottomConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="LeftConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="Shadow" Property="Effect" Value="{DynamicResource Effect.Raised}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            ミニマル表示。丸ひとつと線だけにする。
            箱は 24x24（NodeViewModel.CardWidth / CardHeight と同じ）で、丸そのものが箱。
            短い名前は丸の下に常時表示し、選択・ホバー時には右横に詳細を出す。
            Grid は中身を切り取らないので、はみ出したまま描かれる。
        -->
        <DataTemplate x:Key="NodeMinimalTemplate">
            <!-- 13px の丸と偶数径の輪を同心に保つため、半端な座標を丸めない。 -->
            <Grid x:Name="Root" Width="24" Height="24" Opacity="{Binding CardOpacity}"
                  UseLayoutRounding="False" SnapsToDevicePixels="False"
                  Background="Transparent" Cursor="SizeAll"
                  ToolTip="{Binding CardTooltip}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NodeRepeatLoopTemplate}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="{Binding RepeatLoopWidth}" Height="{Binding RepeatLoopHeight}"
                                Margin="{Binding RepeatLoopMargin}" Focusable="False"
                                Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" />

                <!-- 名前を常時表示して、丸だけでもタスクを識別できるようにする。 -->
                <TextBlock Text="⚑" FontSize="14" Margin="-10,-19,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.Accent}"
                           Visibility="{Binding HasBookmark, Converter={StaticResource BoolToVisibility}}" />
                <Border Width="96" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="-36,34,-36,-30" Background="{DynamicResource Brush.Canvas}"
                        Padding="3,1" CornerRadius="3" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="10.5" TextAlignment="Center"
                                   Foreground="{Binding TitleBrush}"
                                   TextDecorations="{Binding TitleDecorations}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <!-- 畳んでいる印。この先にまだ続きがあることを、外側の破線で示す。 -->
                <Ellipse Width="24" Height="24" StrokeThickness="1" StrokeDashArray="2 2"
                         Stroke="{DynamicResource Node.TextSubtle}"
                         Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}" />

                <!-- 進行中のまわりに敷く、薄い輪 -->
                <Ellipse Width="20" Height="20" Fill="{Binding DotFill}" Opacity="0.2"
                         Visibility="{Binding HasHalo, Converter={StaticResource BoolToVisibility}}" />

                <!-- 最長経路・種別を表す外側の輪 -->
                <Ellipse Width="20" Height="20"
                         Stroke="{Binding RingBrush}" StrokeThickness="1.8"
                         Visibility="{Binding HasRing, Converter={StaticResource BoolToVisibility}}" />

                <!-- 状態を表す丸 -->
                <Ellipse Width="13" Height="13"
                         Fill="{Binding DotFill}"
                         Stroke="{Binding DotStroke}"
                         StrokeThickness="{Binding DotStrokeThickness}" />

                <!-- 選んでいる印 -->
                <Ellipse Width="24" Height="24" StrokeThickness="2"
                         Stroke="{DynamicResource Node.Selected.Stroke}"
                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />

                <!-- ブロックを選んでいるあいだ、その中の丸だけに出る控えめな破線 -->
                <Ellipse Width="28" Height="28" StrokeThickness="1.6" StrokeDashArray="2 2"
                         Stroke="{DynamicResource Block.Member.Stroke}" IsHitTestVisible="False"
                         Visibility="{Binding IsInSelectedBlock, Converter={StaticResource BoolToVisibility}}" />

                <!-- 期限超過・要着手の印。文字は出さず、肩に点を置くだけ。 -->
                <Ellipse Width="6" Height="6" Margin="0,-1,-1,0"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Fill="{Binding AlertBrush}"
                         Visibility="{Binding HasAlert, Converter={StaticResource BoolToVisibility}}" />

                <!-- ここからドラッグして次のステップへ繋ぐ -->
                <Ellipse x:Name="Connector" Tag="connector" Width="12" Height="12"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-7,0"
                         Fill="{DynamicResource Node.Connector.Fill}"
                         Stroke="{Binding DotStroke}" StrokeThickness="2"
                         Opacity="0" Cursor="Cross"
                         ToolTip="ここからドラッグして、次のステップに繋げます" />
                <Ellipse x:Name="TopConnector" Tag="connector-top" Width="12" Height="12"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-7,0,0"
                         Fill="{DynamicResource Node.Connector.Fill}"
                         Stroke="{Binding DotStroke}" StrokeThickness="2"
                         Opacity="0" Cursor="Cross"
                         ToolTip="上からドラッグして、次のステップに繋げます" />
                <Ellipse x:Name="BottomConnector" Tag="connector-bottom" Width="12" Height="12"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-7"
                         Fill="{DynamicResource Node.Connector.Fill}"
                         Stroke="{Binding DotStroke}" StrokeThickness="2"
                         Opacity="0" Cursor="Cross"
                         ToolTip="下からドラッグして、次のステップに繋げます" />
                <Ellipse x:Name="LeftConnector" Tag="connector-left" Width="12" Height="12"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-7,0,0,0"
                         Fill="{DynamicResource Node.Connector.Fill}"
                         Stroke="{Binding DotStroke}" StrokeThickness="2"
                         Opacity="0" Cursor="Cross"
                         ToolTip="左からドラッグして、次のステップに繋げます" />

                <!--
                    名前。丸の右横に、浮かせて出す。
                    箱の外にあるが Root の子なので、この上にカーソルがあっても
                    Root.IsMouseOver は true のまま＝出したまま押せる。
                -->
                <Border x:Name="Chip" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="36,0,0,0" Padding="9,3"
                        Background="{DynamicResource Brush.Overlay}"
                        BorderBrush="{DynamicResource Brush.OverlayBorder}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="12" MaxWidth="240"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding TitleBrush}"
                                   TextDecorations="{Binding TitleDecorations}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Width="196" Padding="3,1" VerticalAlignment="Center"
                                 AcceptsReturn="False"
                                 behaviors:FocusBehavior.FocusWhenVisible="True"
                                 KeyDown="OnCardEditorKeyDown"
                                 LostKeyboardFocus="OnCardEditorLostFocus"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding RepeatText}" FontSize="10.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RepeatTextBrush}"
                                   Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding CollapsedBadge}" FontSize="10.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Node.TextSubtle}"
                                   Visibility="{Binding HasCollapsedBadge, Converter={StaticResource BoolToVisibility}}" />

                        <Button Tag="collapse" Style="{StaticResource Btn.Chip}"
                                Content="{Binding CollapseLabel}"
                                Margin="8,0,0,0" Padding="5,0" MinWidth="20" FontSize="9.5"
                                VerticalAlignment="Center"
                                Visibility="{Binding CanCollapse, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="この先を畳む / 開く" />
                    </StackPanel>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnectionDragging, RelativeSource={RelativeSource AncestorType={x:Type controls:GraphView}}}" Value="True">
                    <Setter TargetName="Connector" Property="Opacity" Value="1" />
                    <Setter TargetName="TopConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="BottomConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="LeftConnector" Property="Opacity" Value="1" />
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Connector" Property="Opacity" Value="1" />
                    <Setter TargetName="TopConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="BottomConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="LeftConnector" Property="Opacity" Value="1" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Chip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Connector" Property="Opacity" Value="1" />
                    <Setter TargetName="TopConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="BottomConnector" Property="Opacity" Value="1" />
                    <Setter TargetName="LeftConnector" Property="Opacity" Value="1" />
                </DataTrigger>
                <!-- 名前を書き換えている最中は、カーソルが外れても出したままにする -->
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="Chip" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Viewport"
          Background="{DynamicResource Brush.Canvas}"
          ClipToBounds="True"
          Focusable="True"
          FocusVisualStyle="{x:Null}"
          MouseWheel="OnViewportMouseWheel"
          PreviewMouseLeftButtonDown="OnViewportPreviewMouseLeftButtonDown"
          PreviewMouseRightButtonDown="OnViewportPreviewMouseRightButtonDown"
          ContextMenuOpening="OnViewportContextMenuOpening"
          MouseLeftButtonUp="OnViewportMouseLeftButtonUp"
          MouseDown="OnViewportMouseDown"
          MouseUp="OnViewportMouseUp"
          MouseMove="OnViewportMouseMove"
          KeyDown="OnViewportKeyDown">

        <Canvas x:Name="Surface">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 方眼（キャンバスと一緒に動く）。ミニマル表示では静かにするため隠す。 -->
            <Rectangle Canvas.Left="-6000" Canvas.Top="-6000" Width="12000" Height="12000"
                       Fill="{DynamicResource Brush.CanvasGrid}" IsHitTestVisible="False"
                       Visibility="{Binding IsMinimalView, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

            <!--
                ステップをまとめた囲み。線やカードより奥に敷き、状態色の主役をカードに残す。
                本体は当たり判定を持たないので、囲みの中の空白でも背景ドラッグでキャンバスを動かせる。
                掴めるのは見出しだけ。
            -->
            <ItemsControl x:Name="BlockHost" ItemsSource="{Binding Blocks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                            <Border CornerRadius="14" Background="{Binding BodyFill}" IsHitTestVisible="False" />

                            <!-- 展開時は囲みの見出し、折りたたみ時は一枚のカードとして表示する。 -->
                            <Border Tag="block-header" VerticalAlignment="Top"
                                    Padding="10,0,12,0" Background="{Binding HeaderFill}"
                                    Cursor="{Binding HeaderCursor}" ToolTip="{Binding Tooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="{Binding HeaderHeight}" />
                                        <Setter Property="CornerRadius" Value="14,14,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="Height" Value="{Binding Height}" />
                                                <Setter Property="CornerRadius" Value="14" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Tag="block-collapse" Style="{StaticResource BlockCollapseButton}"
                                            Click="OnBlockCollapseClick" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{Binding HeaderText}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                    <!-- 件数の領域を確保し、長い名前もカードからはみ出させない。 -->
                                    <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" FontWeight="SemiBold" Padding="4,1" MinWidth="0"
                                             VerticalAlignment="Center" AcceptsReturn="False"
                                             behaviors:FocusBehavior.FocusWhenVisible="True"
                                             KeyDown="OnBlockEditorKeyDown" LostKeyboardFocus="OnBlockEditorLostFocus"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Grid.Column="2" Margin="10,0,0,0" Padding="8,3" CornerRadius="8"
                                            VerticalAlignment="Center" Background="{Binding BodyFill}">
                                        <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                                   Foreground="{Binding CountBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border CornerRadius="14" BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="{Binding BorderThickness}" IsHitTestVisible="False" />
                            <Ellipse Tag="connector-left" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="-6,0,0,0" Fill="{Binding HeaderFill}" Stroke="{Binding BorderBrush}" StrokeThickness="2" Cursor="Cross" ToolTip="ブロック全体へ接続" />
                            <Ellipse Tag="connector" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Margin="0,0,-6,0" Fill="{Binding HeaderFill}" Stroke="{Binding BorderBrush}" StrokeThickness="2" Cursor="Cross" ToolTip="ブロック全体から接続" />
                            <Ellipse Tag="connector-top" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top"
                                     Margin="0,-6,0,0" Fill="{Binding HeaderFill}" Stroke="{Binding BorderBrush}" StrokeThickness="2" Cursor="Cross" ToolTip="ブロック全体へ接続" />
                            <Ellipse Tag="connector-bottom" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Margin="0,0,0,-6" Fill="{Binding HeaderFill}" Stroke="{Binding BorderBrush}" StrokeThickness="2" Cursor="Cross" ToolTip="ブロック全体から接続" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ステップ同士を結ぶ線 -->
            <controls:EdgeLayer x:Name="EdgeRenderer" Edges="{Binding Edges}" Nodes="{Binding Nodes}" Blocks="{Binding Blocks}" />

            <!-- ステップのカード -->
            <ItemsControl x:Name="NodeHost" ItemsSource="{Binding Nodes}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource NodeCardTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMinimalView}" Value="True">
                                <Setter Property="ItemTemplate" Value="{StaticResource NodeMinimalTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        <Style.Triggers>
                            <!-- ミニマル表示の名前は箱からはみ出すので、隣に隠されないよう持ち上げる -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Panel.ZIndex" Value="350" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Canvas>

        <controls:AlignmentGuideLayer x:Name="AlignmentGuides" IsHitTestVisible="False"
                                      GuideBrush="{DynamicResource AlignmentGuideBrush}" />

        <!-- 全体のどこを見ているか -->
        <Border x:Name="CompletionHint" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="12,8"
                Background="{DynamicResource Brush.Overlay}" BorderBrush="{DynamicResource Brush.Accent}"
                BorderThickness="1" CornerRadius="10" MaxWidth="420">
            <TextBlock x:Name="CompletionHintText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text}" />
        </Border>

        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
                Background="{DynamicResource Brush.Overlay}"
                BorderBrush="{DynamicResource Brush.OverlayBorder}"
                BorderThickness="1" CornerRadius="11" Padding="4">
            <controls:MiniMap x:Name="MiniMapView" Width="184" Height="118" />
        </Border>

        <!-- 使い方の小さな案内 -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14"
                Background="{DynamicResource Brush.Overlay}"
                BorderBrush="{DynamicResource Brush.OverlayBorder}"
                BorderThickness="1" CornerRadius="10" Padding="11,7" IsHitTestVisible="False"
                MaxWidth="420">
            <TextBlock FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextFaint}"
                       Text="ホイールで拡大縮小 ・ 背景をドラッグで移動 ・ Alt+ドラッグで矩形選択 ・ Ctrl+クリックで複数選択 ・ 右の丸から線を引いて接続 ・ 線をクリックして Delete で外す ・ Ctrl+G でブロックにまとめる" />
        </Border>
    </Grid>
</UserControl>
