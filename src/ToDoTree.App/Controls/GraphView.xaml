<UserControl x:Class="ToDoTree.App.Controls.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ToDoTree.App.Controls"
             xmlns:converters="clr-namespace:ToDoTree.App.Converters"
             xmlns:behaviors="clr-namespace:ToDoTree.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid x:Name="Viewport"
          Background="{StaticResource CanvasBackgroundBrush}"
          ClipToBounds="True"
          Focusable="True"
          FocusVisualStyle="{x:Null}"
          MouseWheel="OnViewportMouseWheel"
          PreviewMouseLeftButtonDown="OnViewportPreviewMouseLeftButtonDown"
          MouseLeftButtonUp="OnViewportMouseLeftButtonUp"
          MouseDown="OnViewportMouseDown"
          MouseUp="OnViewportMouseUp"
          MouseMove="OnViewportMouseMove"
          KeyDown="OnViewportKeyDown">

        <Canvas x:Name="Surface">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 方眼（キャンバスと一緒に動く） -->
            <Rectangle Canvas.Left="-6000" Canvas.Top="-6000" Width="12000" Height="12000"
                       Fill="{StaticResource CanvasGridBrush}" IsHitTestVisible="False" />

            <!-- ステップ同士を結ぶ線 -->
            <controls:EdgeLayer x:Name="EdgeRenderer" Edges="{Binding Edges}" />

            <!-- ステップのカード -->
            <ItemsControl x:Name="NodeHost" ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="226" Height="78" Opacity="{Binding CardOpacity}">
                            <Border Width="210" Height="78" HorizontalAlignment="Left"
                                    CornerRadius="10"
                                    Background="{Binding Fill}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="{Binding CardBorderThickness}"
                                    ClipToBounds="True"
                                    Cursor="SizeAll"
                                    ToolTip="{Binding CardTooltip}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0" Fill="{Binding KindAccent}" />

                                    <Button Grid.Column="1" Tag="collapse"
                                            Style="{StaticResource ToolButtonStyle}"
                                            Content="{Binding CollapseLabel}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,3,2" Padding="4,0" MinWidth="20" FontSize="10"
                                            Foreground="#FF8A93A5"
                                            Visibility="{Binding CanCollapse, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="この先を畳む / 開く" />

                                    <StackPanel Grid.Column="1" Margin="10,7,26,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" />
                                            <TextBlock Text="{Binding KindLabel}" FontSize="10" Margin="8,0,0,0"
                                                       Foreground="#FFA6ADBB" />
                                            <TextBlock Text="{Binding AlertText}" FontSize="10" Margin="8,0,0,0" FontWeight="SemiBold"
                                                       Foreground="{Binding AlertBrush}"
                                                       Visibility="{Binding HasAlert, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <Grid Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding TitleBrush}"
                                                       TextDecorations="{Binding TitleDecorations}"
                                                       TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                            <!-- カードの上でそのまま名前を書き換える -->
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" FontWeight="SemiBold"
                                                     Padding="2,0" BorderThickness="1"
                                                     TextWrapping="Wrap" MaxHeight="34" AcceptsReturn="False"
                                                     behaviors:FocusBehavior.FocusWhenVisible="True"
                                                     KeyDown="OnCardEditorKeyDown"
                                                     LostKeyboardFocus="OnCardEditorLostFocus"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <TextBlock Text="{Binding MetaText}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="#FFA6ADBB" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ここからドラッグして次のステップへ繋ぐ -->
                            <Ellipse Tag="connector" Width="16" Height="16"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Fill="White" Stroke="{Binding BorderBrush}" StrokeThickness="2"
                                     Cursor="Cross"
                                     ToolTip="ここからドラッグして、次のステップに繋げます" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <!-- 全体のどこを見ているか -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                Background="#F2FFFFFF" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="3">
            <controls:MiniMap x:Name="MiniMapView" Width="184" Height="118" />
        </Border>

        <!-- 使い方の小さな案内 -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12"
                Background="#CCFFFFFF" CornerRadius="8" Padding="10,6" IsHitTestVisible="False">
            <TextBlock FontSize="11" Foreground="#FF7A8194"
                       Text="ホイールで拡大縮小 ・ 背景をドラッグで移動 ・ Alt+ドラッグで矩形選択 ・ Ctrl+クリックで複数選択 ・ 右の丸から線を引いて接続 ・ 線をクリックして Delete で外す" />
        </Border>
    </Grid>
</UserControl>
