<!--
    暗いテーマの色。ライトと同じキーを必ず両方に用意すること。
    参照側は StaticResource ではなく DynamicResource を使う（切り替えに追随させるため）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ==== 画面の地色 ==== -->
    <SolidColorBrush x:Key="Brush.Window"        Color="#FF09111D" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Chrome"        Color="#FF101C2C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"       Color="#FF132235" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"    Color="#FF192B40" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceHover"  Color="#FF232935" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceActive" Color="#FF2C3341" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Canvas"        Color="#FF0B1625" po:Freeze="True" />

    <!-- ==== 枠と区切り ==== -->
    <SolidColorBrush x:Key="Brush.Border"        Color="#FF263A50" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderStrong"  Color="#FF3A4252" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Divider"       Color="#FF1F242E" po:Freeze="True" />

    <!-- ==== 文字 ==== -->
    <SolidColorBrush x:Key="Brush.Text"          Color="#FFE7EAF2" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextSubtle"    Color="#FFACBED0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextFaint"     Color="#FF8FA3BA" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextOnAccent"  Color="#FF0C1020" po:Freeze="True" />

    <!-- ==== アクセント ==== -->
    <SolidColorBrush x:Key="Brush.Accent"        Color="#FF66DFC3" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#FF98ECD8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF42BFA4" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentSoft"    Color="#FF173C3C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentBorder"  Color="#FF34766E" po:Freeze="True" />

    <!-- ==== 状態色 ==== -->
    <SolidColorBrush x:Key="Brush.Danger"        Color="#FFF87171" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.DangerSoft"    Color="#FF2A181B" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning"       Color="#FFFB923C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success"       Color="#FF4ADE80" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SuccessSoft"   Color="#FF13251C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF254936" po:Freeze="True" />

    <!-- ==== スクロールバー ==== -->
    <SolidColorBrush x:Key="Brush.Scroll"        Color="#FF333A48" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ScrollHover"   Color="#FF4B5566" po:Freeze="True" />

    <!-- ==== キャンバスに浮かぶ小窓 ==== -->
    <SolidColorBrush x:Key="Brush.Overlay"       Color="#F21A1F29" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.OverlayBorder" Color="#FF2C3341" po:Freeze="True" />

    <!-- ==== キャンバスの方眼（ドット） ==== -->
    <DrawingBrush x:Key="Brush.CanvasGrid" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Viewbox="0,0,26,26" ViewboxUnits="Absolute" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FF1E2530">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX="0.8" RadiusY="0.8" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ==== カード ==== -->
    <SolidColorBrush x:Key="Node.Blocked.Fill"    Color="#FF182A40" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Blocked.Stroke"  Color="#FF2F3644" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Ready.Fill"      Color="#FF12382F" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Ready.Stroke"    Color="#FF34D399" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Progress.Fill"   Color="#FF1C2949" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Progress.Stroke" Color="#FF7C93FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Done.Fill"       Color="#FF14171D" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Done.Stroke"     Color="#FF262C37" po:Freeze="True" />

    <SolidColorBrush x:Key="Node.Selected.Stroke" Color="#FF98ECD8" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Critical.Stroke" Color="#FFFB923C" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.AtRisk"          Color="#FFFB923C" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Overdue"         Color="#FFF87171" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Text"            Color="#FFE7EAF2" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.TextSubtle"      Color="#FFA3B4C9" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.TextDone"        Color="#FF6B7486" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Connector.Fill"  Color="#FF1C212B" po:Freeze="True" />

    <!-- 回数で完了する項目のバッジ。状態色とは別に、回数だけを静かに示す。 -->
    <SolidColorBrush x:Key="Node.Repeat.Badge"    Color="#FF232B39" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Repeat.Text"     Color="#FFCBD5E6" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Repeat.Loop"     Color="#FF93A2BC" po:Freeze="True" />

    <!-- 種別を表す色帯 -->
    <SolidColorBrush x:Key="Kind.Start"     Color="#FFA78BFA" po:Freeze="True" />
    <SolidColorBrush x:Key="Kind.Step"      Color="#FF3E4657" po:Freeze="True" />
    <SolidColorBrush x:Key="Kind.Milestone" Color="#FF38BDF8" po:Freeze="True" />
    <SolidColorBrush x:Key="Kind.Goal"      Color="#FFFBBF24" po:Freeze="True" />

    <!-- ==== ステップ同士を結ぶ線 ==== -->
    <SolidColorBrush x:Key="Edge.Normal"    Color="#FF3C4457" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Settled"   Color="#FF272D3A" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Highlight" Color="#FF66DFC3" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Critical"  Color="#FFFB923C" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Selected"  Color="#FF98ECD8" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Preview"   Color="#FF7C93FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Marquee.Fill"   Color="#2E7C93FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Marquee.Stroke" Color="#FF7C93FF" po:Freeze="True" />

    <!-- ==== ブロック（囲み） ==== -->
    <!-- カードや線より奥に敷くので、どれも薄い。状態色の主役をカードから奪わない。 -->
    <SolidColorBrush x:Key="Block.Fill"                 Color="#14A3B4C9" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Selected.Fill"        Color="#2298ECD8" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke"               Color="#FF3A4454" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Selected.Stroke"      Color="#FF98ECD8" po:Freeze="True" />
    <!-- 見出しは線と重なっても読めるよう、透けない下地を敷く。 -->
    <SolidColorBrush x:Key="Block.Header.Fill"          Color="#FF232A36" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Selected.Fill" Color="#FF1E3B3A" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Text"          Color="#FFDCE3EE" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Count"         Color="#FF95A5B8" po:Freeze="True" />
    <!-- ブロック選択中に、どのカードが中にいるかを示す控えめな輪郭。 -->
    <SolidColorBrush x:Key="Block.Member.Stroke"        Color="#8098ECD8" po:Freeze="True" />

    <!-- ==== 個別色のプリセット ==== -->
    <!--
        ブロックと線に 1 つずつ付けられる色。キーは「既定のキー + . + id」で揃えてある。
        参照側は色付きのキーを引き、無ければ既定のキーへ落ちる（Services/ColorPalette.cs）。
        ライトとダークに同じ id を必ず両方そろえること。片側だけだと、そのテーマで既定色に戻る。
        選択中の濃い背景と、先行が片付いた線の薄い色は、ここから不透明度で作るのでキーを持たない。
    -->
    <!-- 灰 -->
    <SolidColorBrush x:Key="Block.Fill.slate"            Color="#1E94A3B8" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.slate"          Color="#FF64748B" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.slate"     Color="#FF2A3444" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.slate"           Color="#FF64748B" po:Freeze="True" />

    <!-- 赤 -->
    <SolidColorBrush x:Key="Block.Fill.red"              Color="#1EF87171" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.red"            Color="#FFF87171" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.red"       Color="#FF3A2028" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.red"             Color="#FFEF6B6B" po:Freeze="True" />

    <!-- 橙 -->
    <SolidColorBrush x:Key="Block.Fill.orange"           Color="#1EFB923C" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.orange"         Color="#FFFB923C" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.orange"    Color="#FF36261B" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.orange"          Color="#FFF59A4B" po:Freeze="True" />

    <!-- 黄 -->
    <SolidColorBrush x:Key="Block.Fill.amber"            Color="#1EFBBF24" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.amber"          Color="#FFFBBF24" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.amber"     Color="#FF332B18" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.amber"           Color="#FFEBB43C" po:Freeze="True" />

    <!-- 緑 -->
    <SolidColorBrush x:Key="Block.Fill.green"            Color="#1E4ADE80" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.green"          Color="#FF4ADE80" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.green"     Color="#FF1A3328" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.green"           Color="#FF4ADE80" po:Freeze="True" />

    <!-- 青緑 -->
    <SolidColorBrush x:Key="Block.Fill.teal"             Color="#1E2DD4BF" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.teal"           Color="#FF2DD4BF" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.teal"      Color="#FF15332F" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.teal"            Color="#FF2DD4BF" po:Freeze="True" />

    <!-- 青 -->
    <SolidColorBrush x:Key="Block.Fill.blue"             Color="#1E60A5FA" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.blue"           Color="#FF60A5FA" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.blue"      Color="#FF1B2A45" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.blue"            Color="#FF6E9BF7" po:Freeze="True" />

    <!-- 紫 -->
    <SolidColorBrush x:Key="Block.Fill.violet"           Color="#1EA78BFA" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.violet"         Color="#FFA78BFA" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.violet"    Color="#FF272348" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.violet"          Color="#FF9B87F5" po:Freeze="True" />

    <!-- 桃 -->
    <SolidColorBrush x:Key="Block.Fill.pink"             Color="#1EF472B6" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.pink"           Color="#FFF472B6" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.pink"      Color="#FF3A2036" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.pink"            Color="#FFEE72B0" po:Freeze="True" />

    <!-- ==== ミニマップ ==== -->
    <SolidColorBrush x:Key="MiniMap.Surface"         Color="#FF14181F" po:Freeze="True" />
    <SolidColorBrush x:Key="MiniMap.Viewport.Fill"   Color="#1F7C93FF" po:Freeze="True" />
    <SolidColorBrush x:Key="MiniMap.Viewport.Stroke" Color="#FF7C93FF" po:Freeze="True" />
    <SolidColorBrush x:Key="MiniMap.Block.Stroke"     Color="#FF48546A" po:Freeze="True" />

    <!-- ==== 影 ==== -->
    <DropShadowEffect x:Key="Effect.Card"   Color="#FF000000" Opacity="0.55" BlurRadius="16" ShadowDepth="4"
                      Direction="270" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Raised" Color="#FF000000" Opacity="0.70" BlurRadius="30" ShadowDepth="8"
                      Direction="270" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Panel"  Color="#FF000000" Opacity="0.38" BlurRadius="20" ShadowDepth="3"
                      Direction="270" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Popup"  Color="#FF000000" Opacity="0.66" BlurRadius="28" ShadowDepth="6"
                      Direction="270" RenderingBias="Performance" po:Freeze="True" />

    <SolidColorBrush x:Key="AlignmentGuideBrush" Color="#93C5FD" />
</ResourceDictionary>
