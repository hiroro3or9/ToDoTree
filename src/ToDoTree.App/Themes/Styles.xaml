<!--
    文字づかいと小さな部品。色は Palette.*.xaml のキーを DynamicResource で引く。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 文字 ================= -->
    <Style x:Key="Text.AppMark" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- パネルの見出し。少し字間を空けて小さく。 -->
    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="2,14,0,6" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="2,12,0,5" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="Text.Meta" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
        <Setter Property="FontSize" Value="10.5" />
    </Style>

    <!-- ================= 小さなラベル（ピル） ================= -->
    <Style x:Key="Pill.Neutral" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Pill.Accent" TargetType="Border" BasedOn="{StaticResource Pill.Neutral}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
    </Style>

    <Style x:Key="Pill.Success" TargetType="Border" BasedOn="{StaticResource Pill.Neutral}">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
    </Style>

    <!-- ================= 区切り線 ================= -->
    <Style x:Key="Rule.Vertical" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="7,7" />
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
    </Style>

    <Style x:Key="Rule.Horizontal" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
    </Style>

</ResourceDictionary>
