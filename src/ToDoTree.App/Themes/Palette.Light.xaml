<!--
    明るいテーマの色。ダークと同じキーを必ず両方に用意すること。
    参照側は StaticResource ではなく DynamicResource を使う（切り替えに追随させるため）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ==== 画面の地色 ==== -->
    <SolidColorBrush x:Key="Brush.Window"        Color="#FFEAF0F3" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Chrome"        Color="#FFF8FBFC" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface"       Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"    Color="#FFF0F5F6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceHover"  Color="#FFEDEFF4" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SurfaceActive" Color="#FFE3E6ED" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Canvas"        Color="#FFF3F8F9" po:Freeze="True" />

    <!-- ==== 枠と区切り ==== -->
    <SolidColorBrush x:Key="Brush.Border"        Color="#FFD8E4E8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderStrong"  Color="#FFD3D8E2" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Divider"       Color="#FFEBEDF2" po:Freeze="True" />

    <!-- ==== 文字 ==== -->
    <SolidColorBrush x:Key="Brush.Text"          Color="#FF192D40" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextSubtle"    Color="#FF536D7C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextFaint"     Color="#FF667E8C" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextOnAccent"  Color="#FFFFFFFF" po:Freeze="True" />

    <!-- ==== アクセント ==== -->
    <SolidColorBrush x:Key="Brush.Accent"        Color="#FF087F73" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#FF06685F" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF05564F" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentSoft"    Color="#FFE5F5F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentBorder"  Color="#FFACD9CB" po:Freeze="True" />

    <!-- ==== 状態色 ==== -->
    <SolidColorBrush x:Key="Brush.Danger"        Color="#FFDC2626" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.DangerSoft"    Color="#FFFEF0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning"       Color="#FFE0640D" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success"       Color="#FF16A34A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SuccessSoft"   Color="#FFF1FAF4" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FFC9E9D6" po:Freeze="True" />

    <!-- ==== スクロールバー ==== -->
    <SolidColorBrush x:Key="Brush.Scroll"        Color="#FFCFD4DE" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ScrollHover"   Color="#FFAAB2C0" po:Freeze="True" />

    <!-- ==== キャンバスに浮かぶ小窓 ==== -->
    <SolidColorBrush x:Key="Brush.Overlay"       Color="#F5FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.OverlayBorder" Color="#FFE5E8EE" po:Freeze="True" />

    <!-- ==== キャンバスの方眼（ドット） ==== -->
    <DrawingBrush x:Key="Brush.CanvasGrid" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FFE0E4EC">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX="0.8" RadiusY="0.8" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ==== カード ==== -->
    <SolidColorBrush x:Key="Node.Blocked.Fill"   Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Blocked.Stroke" Color="#FFDCE1E9" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Ready.Fill"     Color="#FFF4FCF7" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Ready.Stroke"   Color="#FF22C55E" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Progress.Fill"  Color="#FFF1F4FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Progress.Stroke" Color="#FF4B6BFB" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Done.Fill"      Color="#FFF6F7F9" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Done.Stroke"    Color="#FFDBE0E7" po:Freeze="True" />

    <SolidColorBrush x:Key="Node.Selected.Stroke" Color="#FF087F73" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Critical.Stroke" Color="#FFF97316" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.AtRisk"          Color="#FFEA580C" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Overdue"         Color="#FFDC2626" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Text"            Color="#FF1B2030" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.TextSubtle"      Color="#FF617887" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.TextDone"        Color="#FF71828B" po:Freeze="True" />
    <SolidColorBrush x:Key="Node.Connector.Fill"  Color="#FFFFFFFF" po:Freeze="True" />

    <!-- 種別を表す色帯 -->
    <SolidColorBrush x:Key="Kind.Start"     Color="#FF8B5CF6" po:Freeze="True" />
    <SolidColorBrush x:Key="Kind.Step"      Color="#FFCBD5E1" po:Freeze="True" />
    <SolidColorBrush x:Key="Kind.Milestone" Color="#FF0EA5E9" po:Freeze="True" />
    <SolidColorBrush x:Key="Kind.Goal"      Color="#FFF59E0B" po:Freeze="True" />

    <!-- ==== ステップ同士を結ぶ線 ==== -->
    <SolidColorBrush x:Key="Edge.Normal"    Color="#FFB9C0CE" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Settled"   Color="#FFDCE0E8" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Highlight" Color="#FF087F73" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Critical"  Color="#FFF97316" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Selected"  Color="#FF087F73" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Preview"   Color="#FF4B6BFB" po:Freeze="True" />
    <SolidColorBrush x:Key="Marquee.Fill"   Color="#1F4B6BFB" po:Freeze="True" />
    <SolidColorBrush x:Key="Marquee.Stroke" Color="#FF4B6BFB" po:Freeze="True" />

    <!-- ==== ブロック（囲み） ==== -->
    <!-- カードや線より奥に敷くので、どれも薄い。状態色の主役をカードから奪わない。 -->
    <SolidColorBrush x:Key="Block.Fill"                 Color="#0F5B7488" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Selected.Fill"        Color="#1A087F73" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke"               Color="#FFC3CCD8" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Selected.Stroke"      Color="#FF087F73" po:Freeze="True" />
    <!-- 見出しは線と重なっても読めるよう、透けない下地を敷く。 -->
    <SolidColorBrush x:Key="Block.Header.Fill"          Color="#FFEDF1F5" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Selected.Fill" Color="#FFD9EFEA" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Text"          Color="#FF334155" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Count"         Color="#FF7A8A99" po:Freeze="True" />
    <!-- ブロック選択中に、どのカードが中にいるかを示す控えめな輪郭。 -->
    <SolidColorBrush x:Key="Block.Member.Stroke"        Color="#66087F73" po:Freeze="True" />

    <!-- ==== 個別色のプリセット ==== -->
    <!--
        ブロックと線に 1 つずつ付けられる色。キーは「既定のキー + . + id」で揃えてある。
        参照側は色付きのキーを引き、無ければ既定のキーへ落ちる（Services/ColorPalette.cs）。
        ライトとダークに同じ id を必ず両方そろえること。片側だけだと、そのテーマで既定色に戻る。
        選択中の濃い背景と、先行が片付いた線の薄い色は、ここから不透明度で作るのでキーを持たない。
    -->
    <!-- 灰 -->
    <SolidColorBrush x:Key="Block.Fill.slate"            Color="#1494A3B8" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.slate"          Color="#FF94A3B8" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.slate"     Color="#FFE4EAF1" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.slate"           Color="#FF94A3B8" po:Freeze="True" />

    <!-- 赤 -->
    <SolidColorBrush x:Key="Block.Fill.red"              Color="#14DC2626" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.red"            Color="#FFDC2626" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.red"       Color="#FFFBE9E9" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.red"             Color="#FFDC2626" po:Freeze="True" />

    <!-- 橙 -->
    <SolidColorBrush x:Key="Block.Fill.orange"           Color="#14F97316" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.orange"         Color="#FFF97316" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.orange"    Color="#FFFDEEE1" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.orange"          Color="#FFEA580C" po:Freeze="True" />

    <!-- 黄 -->
    <SolidColorBrush x:Key="Block.Fill.amber"            Color="#14D97706" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.amber"          Color="#FFD97706" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.amber"     Color="#FFFBF1DC" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.amber"           Color="#FFD97706" po:Freeze="True" />

    <!-- 緑 -->
    <SolidColorBrush x:Key="Block.Fill.green"            Color="#1422C55E" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.green"          Color="#FF22C55E" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.green"     Color="#FFE8F7EE" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.green"           Color="#FF16A34A" po:Freeze="True" />

    <!-- 青緑 -->
    <SolidColorBrush x:Key="Block.Fill.teal"             Color="#140D9488" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.teal"           Color="#FF0D9488" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.teal"      Color="#FFE2F3F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.teal"            Color="#FF0D9488" po:Freeze="True" />

    <!-- 青 -->
    <SolidColorBrush x:Key="Block.Fill.blue"             Color="#143B82F6" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.blue"           Color="#FF3B82F6" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.blue"      Color="#FFE7EFFD" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.blue"            Color="#FF2563EB" po:Freeze="True" />

    <!-- 紫 -->
    <SolidColorBrush x:Key="Block.Fill.violet"           Color="#148B5CF6" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.violet"         Color="#FF8B5CF6" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.violet"    Color="#FFF0EAFE" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.violet"          Color="#FF7C3AED" po:Freeze="True" />

    <!-- 桃 -->
    <SolidColorBrush x:Key="Block.Fill.pink"             Color="#14EC4899" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Stroke.pink"           Color="#FFEC4899" po:Freeze="True" />
    <SolidColorBrush x:Key="Block.Header.Fill.pink"      Color="#FFFCE8F1" po:Freeze="True" />
    <SolidColorBrush x:Key="Edge.Normal.pink"            Color="#FFDB2777" po:Freeze="True" />

    <!-- ==== ミニマップ ==== -->
    <SolidColorBrush x:Key="MiniMap.Surface"         Color="#FFF7F8FA" po:Freeze="True" />
    <SolidColorBrush x:Key="MiniMap.Viewport.Fill"   Color="#144B6BFB" po:Freeze="True" />
    <SolidColorBrush x:Key="MiniMap.Viewport.Stroke" Color="#FF4B6BFB" po:Freeze="True" />
    <SolidColorBrush x:Key="MiniMap.Block.Stroke"     Color="#FFB6C2CF" po:Freeze="True" />

    <!-- ==== 影 ==== -->
    <DropShadowEffect x:Key="Effect.Card"    Color="#FF20293D" Opacity="0.13" BlurRadius="14" ShadowDepth="3"
                      Direction="270" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Raised"  Color="#FF20293D" Opacity="0.20" BlurRadius="26" ShadowDepth="7"
                      Direction="270" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Panel"   Color="#FF20293D" Opacity="0.07" BlurRadius="18" ShadowDepth="2"
                      Direction="270" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Popup"   Color="#FF10162A" Opacity="0.24" BlurRadius="24" ShadowDepth="5"
                      Direction="270" RenderingBias="Performance" po:Freeze="True" />

    <SolidColorBrush x:Key="AlignmentGuideBrush" Color="#2563EB" />
</ResourceDictionary>
